# Copy to .env (gitignored) for local testing. NEVER commit real values.
# In CI these come from GitHub organisation or repository secrets of the
# same name. GitHub has no account-wide Actions secrets -- see docs/SETUP.md.
DEVTO_API_KEY=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# Not a secret: the date you last ran the LinkedIn OAuth flow (YYYY-MM-DD).
# In CI this is a repository *variable*, not a secret. Drives the expiry warning.
LINKEDIN_TOKEN_ISSUED_AT=
